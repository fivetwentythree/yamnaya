@article{wong_reconstructing_2017,
	address = {Cold Spring Harbor},
	title = {Reconstructing genetic history of {Siberian} and {Northeastern} {European} populations},
	volume = {27},
	issn = {1088-9051, 1549-5469},
	doi = {10.1101/gr.202945.115},
	abstract = {Siberia and Northwestern Russia are home to over 40 culturally and linguistically diverse indigenous ethnic groups, yet genetic variation and histories of peoples from this region are largely uncharacterized. We present deep whole-genome sequencing data (similar to 38x) from 28 individuals belonging to 14 distinct indigenous populations from that region. We combined these data sets with additional 32 modern-day and 46 ancient human genomes to reconstruct genetic histories of several indigenous Northern Eurasian populations. We found that Siberian and East Asian populations shared 38\% of their ancestry with a 45,000-yr-old Ust'-Ishim individual who was previously believed to have no modern-day descendants. Western Siberians trace 57\% of their ancestry to ancient North Eurasians, represented by the 24,000-yr-old Siberian Mal'ta boy MA-1. Eastern Siberian populations formed a distinct sublineage that separated from other East Asian populations similar to 10,000 yr ago. In addition, we uncovered admixtures between Siberians and Eastern European hunter-gatherers from Samara, Karelia, Hungary, and Sweden (from 8000-6600 yr ago); Yamnaya people (5300-4700 yr ago); and modern-day Northeastern Europeans. Our results provide new insights into genetic histories of Siberian and Northeastern European populations and evidence of ancient gene flow from Siberia into Europe.},
	language = {English},
	number = {1},
	journal = {Genome Research},
	publisher = {Cold Spring Harbor Lab Press, Publications Dept},
	author = {Wong, Emily N. M. and Khrunin, Andrey and Nichols, Larissa and Pushkarev, Dmitry and Khokhrin, Denis and Verbenko, Dmitry and Evgrafov, Oleg and Knowles, James and Novembre, John and Limborska, Svetlana and Valouev, Anton},
	month = jan,
