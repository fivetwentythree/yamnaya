Web of Science ID: WOS:000534787200001},
	keywords = {MIGRATION, FARMERS, MOBILITY, POPULATIONS, PATTERNS, ANCIENT HUMAN GENOMES, CLUSTERS, DNA-SEQUENCES, INDO-EUROPEAN LANGUAGES, SELECTION},
